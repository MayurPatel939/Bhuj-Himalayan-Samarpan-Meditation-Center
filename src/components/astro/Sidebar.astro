---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { isSuperAdmin } from '@/lib/auth/permissions';

const { t, user, profile, roles } = Astro.locals;
const currentPath = Astro.url.pathname;
const isSuper = isSuperAdmin(roles);

const menuItems = [
  { href: '/dashboard', label: t('nav.dashboard'), icon: 'dashboard', roles: ['all'] },
  { href: '/dashboard/seekers', label: t('nav.seekers'), icon: 'users', roles: ['all'] },
  { href: '/dashboard/centers', label: t('nav.centers'), icon: 'building', roles: ['all'] },
  { href: '/dashboard/events', label: t('nav.events'), icon: 'calendar', roles: ['super_admin', 'admin', 'event_coordinator', 'center_coordinator'] },
  { href: '/dashboard/transport', label: t('nav.transport'), icon: 'bus', roles: ['super_admin', 'admin', 'dhyan_rath_coordinator', 'bus_coordinator', 'event_coordinator', 'center_coordinator'] },
  { href: '/dashboard/activities', label: t('nav.activities'), icon: 'moon', roles: ['super_admin', 'admin', 'ratri_sadhna_coordinator', 'center_coordinator'] },
  { href: '/dashboard/products', label: t('nav.products'), icon: 'shopping-bag', roles: ['super_admin', 'admin', 'product_coordinator', 'center_coordinator'] },
  { href: '/dashboard/sahitya', label: t('nav.sahitya'), icon: 'book', roles: ['super_admin', 'admin', 'sahitya_coordinator', 'center_coordinator'] },
  { href: '/dashboard/finance', label: t('nav.finance'), icon: 'wallet', roles: ['super_admin', 'admin', 'event_coordinator'] },
  { href: '/dashboard/notifications', label: t('nav.notifications'), icon: 'message-circle', roles: ['super_admin', 'admin', 'event_coordinator', 'center_coordinator'] },
  { href: '/dashboard/settings', label: t('nav.settings'), icon: 'settings', roles: ['super_admin'] },
];

const userRoleNames = (roles || []).map((r) => r.role_name);
const filteredMenu = menuItems.filter((item) => {
  if (item.roles.includes('all')) return true;
  if (isSuper) return true;
  return item.roles.some((r) => userRoleNames.includes(r));
});
---

<aside class="w-64 bg-white border-r border-gray-100 flex flex-col flex-shrink-0 min-h-screen">
  <!-- Brand / Header -->
  <div class="h-16 px-5 border-b border-gray-100 flex items-center justify-between">
    <a href="/dashboard" class="flex items-center gap-2.5">
      <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-[#E8973A] to-[#F3AA55] flex items-center justify-center text-white font-bold text-sm shadow-xs">
        B
      </div>
      <span class="font-bold text-gray-900 text-sm tracking-tight truncate">
        Samarpan Portal
      </span>
    </a>
    <LanguageSwitcher />
  </div>

  <!-- Navigation items -->
  <div class="flex-1 py-4 px-3 space-y-1 overflow-y-auto">
    {filteredMenu.map((item) => {
      const isActive = currentPath === item.href || (item.href !== '/dashboard' && currentPath.startsWith(item.href));
      return (
        <a
          href={item.href}
          class={`flex items-center gap-3 px-3 py-2.5 rounded-lg text-xs font-semibold transition-colors ${
            isActive
              ? 'bg-[#FDEED9] text-[#C2741C]'
              : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900'
          }`}
        >
          <span class="truncate">{item.label}</span>
        </a>
      );
    })}
  </div>

  <!-- User info & Logout -->
  <div class="p-4 border-t border-gray-100 bg-[#FFF9F3]/40">
    <div class="flex items-center justify-between">
      <div class="min-w-0">
        <p class="text-xs font-semibold text-gray-900 truncate">
          {profile?.full_name || user?.email || 'Coordinator'}
        </p>
        <p class="text-[10px] text-gray-500 capitalize truncate">
          {roles?.[0]?.role_name?.replace(/_/g, ' ') || 'Volunteer'}
        </p>
      </div>

      <form action="/api/auth/logout" method="POST">
        <button
          type="submit"
          class="p-1.5 text-gray-400 hover:text-red-600 rounded-lg hover:bg-red-50 transition-colors cursor-pointer"
          title={t('nav.logout')}
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
          </svg>
        </button>
      </form>
    </div>
  </div>
</aside>
