---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import { CenterForm } from '@/features/centers/components/CenterForm';
import { isAdminOrAbove } from '@/lib/auth/permissions';

const { t, locale, roles } = Astro.locals;

// Guard: Only admins can create centers
if (!isAdminOrAbove(roles)) {
  return Astro.redirect('/dashboard/centers');
}
---

<DashboardLayout title={t('centers.addCenter')}>
  <div class="max-w-3xl mx-auto space-y-6">
    <div>
      <a href="/dashboard/centers" class="text-xs font-semibold text-[#E8973A] hover:underline flex items-center gap-1 mb-1">
        <span>←</span>
        <span>{t('back')} to Centers</span>
      </a>
      <h1 class="text-xl sm:text-2xl font-bold text-gray-900 tracking-tight">
        {t('centers.addCenter')}
      </h1>
    </div>

    <!-- Center Form Island -->
    <CenterForm
      client:load
      locale={locale}
    />
  </div>
</DashboardLayout>
