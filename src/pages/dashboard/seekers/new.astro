---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import { SeekerForm } from '@/features/seekers/components/SeekerForm';

const { t, locale, supabase } = Astro.locals;

// Fetch active centers for the dropdown
const { data: centers } = await supabase
  .from('centers')
  .select('*')
  .eq('is_active', true)
  .order('name_en');
---

<DashboardLayout title={t('seekers.addSeeker')}>
  <div class="max-w-4xl mx-auto space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <a href="/dashboard/seekers" class="text-xs font-semibold text-[#E8973A] hover:underline flex items-center gap-1 mb-1">
          <span>←</span>
          <span>{t('back')} to Directory</span>
        </a>
        <h1 class="text-xl sm:text-2xl font-bold text-gray-900 tracking-tight">
          {t('seekers.addSeeker')}
        </h1>
      </div>
    </div>

    <!-- Seeker Form Island -->
    <SeekerForm
      client:load
      centers={centers || []}
      locale={locale}
    />
  </div>
</DashboardLayout>
