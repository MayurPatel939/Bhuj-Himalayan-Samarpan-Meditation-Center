---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { Card } from '../../components/react/ui/Card';
import { Badge } from '../../components/react/ui/Badge';
import { RecentSeekersTable } from '../../components/react/dashboard/RecentSeekersTable';

const { t, locale, user, profile, roles, supabase } = Astro.locals;

// Fetch high-level counts
let totalSeekersCount = 0;
let activeCentersCount = 0;
let upcomingEventsCount = 0;
let activeTripsCount = 0;
let recentSeekers: any[] = [];

try {
  const [seekersRes, centersRes, eventsRes, tripsRes, recentSeekersRes] = await Promise.all([
    supabase.from('seekers').select('id', { count: 'exact', head: true }).eq('status', 'active'),
    supabase.from('centers').select('id', { count: 'exact', head: true }).eq('is_active', true),
    supabase.from('events').select('id', { count: 'exact', head: true }).gte('start_date', new Date().toISOString()),
    supabase.from('transport_schedules').select('id', { count: 'exact', head: true }).gte('departure_datetime', new Date().toISOString()),
    supabase.from('seekers').select('seeker_id, first_name_en, last_name_en, first_name_gu, mobile, registration_date, status').order('created_at', { ascending: false }).limit(5),
  ]);

  totalSeekersCount = seekersRes.count ?? 0;
  activeCentersCount = centersRes.count ?? 0;
  upcomingEventsCount = eventsRes.count ?? 0;
  activeTripsCount = tripsRes.count ?? 0;
  recentSeekers = recentSeekersRes.data ?? [];
} catch (err) {
  console.warn('Dashboard data fetch fallback in development:', err);
}

// Fallback sample data if database is fresh
if (recentSeekers.length === 0) {
  recentSeekers = [
    { seeker_id: 'BHJ-0001', first_name_en: 'Rameshbhai', last_name_en: 'Patel', first_name_gu: 'રમેશભાઈ', mobile: '9825012345', registration_date: '2026-10-15', status: 'active' },
    { seeker_id: 'BHJ-0002', first_name_en: 'Bhavnaben', last_name_en: 'Shah', first_name_gu: 'ભાવનાબેન', mobile: '9879054321', registration_date: '2026-10-16', status: 'active' },
    { seeker_id: 'BHJ-0003', first_name_en: 'Kiritbhai', last_name_en: 'Vaghela', first_name_gu: 'કિરીટભાઈ', mobile: '9426098765', registration_date: '2026-10-17', status: 'active' },
  ];
  totalSeekersCount = 3;
  activeCentersCount = 3;
  upcomingEventsCount = 1;
}

const tableData = recentSeekers.map((s) => ({
  seeker_id: s.seeker_id,
  name: locale === 'gu' && s.first_name_gu ? `${s.first_name_gu} ${s.last_name_en}` : `${s.first_name_en} ${s.last_name_en}`,
  mobile: s.mobile || '—',
  date: s.registration_date,
  status: s.status,
}));

const headers = {
  seekerId: t('seekers.seekerId'),
  name: t('seekers.name'),
  mobile: t('seekers.mobile'),
  date: 'Registration Date',
  status: t('status'),
  search: t('search'),
};
---

<DashboardLayout title={t('dashboard.overview')}>
  <div class="space-y-6">
    <!-- Welcome Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-white p-6 rounded-2xl border border-gray-100 shadow-2xs">
      <div>
        <span class="text-xs font-semibold text-[#E8973A] uppercase tracking-wider">
          {locale === 'gu' ? 'સમર્પણ સંચાલન પોર્ટલ' : 'Samarpan Management Portal'}
        </span>
        <h1 class="text-xl sm:text-2xl font-bold text-gray-900 mt-1">
          {t('welcome')}, {profile?.full_name || user?.email?.split('@')[0] || 'Coordinator'} 🙏
        </h1>
        <p class="text-xs text-gray-500 mt-1">
          {locale === 'gu'
            ? 'આજના કેન્દ્ર સંચાલન, સાધક નોંધણી અને કાર્યક્રમ આયોજન માટેનું ડેશબોર્ડ.'
            : 'Operational dashboard for seeker tracking, centers, events, and seva management.'}
        </p>
      </div>

      <div class="flex items-center gap-2">
        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-[#FDEED9] text-[#C2741C] text-xs font-semibold border border-[#E8973A]/20">
          <span class="w-2 h-2 rounded-full bg-[#E8973A] animate-pulse"></span>
          <span class="capitalize">{roles?.[0]?.role_name?.replace(/_/g, ' ') || 'Coordinator'}</span>
        </span>
      </div>
    </div>

    <!-- 4 KPI Summary Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
      <div class="p-5 rounded-2xl bg-white border border-gray-100 shadow-2xs flex items-center gap-4">
        <div class="w-12 h-12 rounded-xl bg-[#FDEED9] text-[#C2741C] flex items-center justify-center font-bold text-xl">
          👥
        </div>
        <div>
          <span class="text-xs text-gray-500 font-medium">{t('dashboard.totalSeekers')}</span>
          <p class="text-2xl font-extrabold text-gray-900 mt-0.5">{totalSeekersCount}</p>
        </div>
      </div>

      <div class="p-5 rounded-2xl bg-white border border-gray-100 shadow-2xs flex items-center gap-4">
        <div class="w-12 h-12 rounded-xl bg-[#E8F2FC] text-[#2F6DB1] flex items-center justify-center font-bold text-xl">
          🏛️
        </div>
        <div>
          <span class="text-xs text-gray-500 font-medium">{t('dashboard.activeCenters')}</span>
          <p class="text-2xl font-extrabold text-gray-900 mt-0.5">{activeCentersCount}</p>
        </div>
      </div>

      <div class="p-5 rounded-2xl bg-white border border-gray-100 shadow-2xs flex items-center gap-4">
        <div class="w-12 h-12 rounded-xl bg-[#EDF5EF] text-[#4F7959] flex items-center justify-center font-bold text-xl">
          📅
        </div>
        <div>
          <span class="text-xs text-gray-500 font-medium">{t('dashboard.upcomingEvents')}</span>
          <p class="text-2xl font-extrabold text-gray-900 mt-0.5">{upcomingEventsCount}</p>
        </div>
      </div>

      <div class="p-5 rounded-2xl bg-white border border-gray-100 shadow-2xs flex items-center gap-4">
        <div class="w-12 h-12 rounded-xl bg-[#FFF3E0] text-[#E65100] flex items-center justify-center font-bold text-xl">
          🚐
        </div>
        <div>
          <span class="text-xs text-gray-500 font-medium">{t('dashboard.activeTrips')}</span>
          <p class="text-2xl font-extrabold text-gray-900 mt-0.5">{activeTripsCount}</p>
        </div>
      </div>
    </div>

    <!-- Recent Seekers Table Section -->
    <div class="space-y-3">
      <div class="flex items-center justify-between">
        <h2 class="text-base font-bold text-gray-900">
          {t('dashboard.recentSeekers')}
        </h2>
        <a
          href="/dashboard/seekers"
          class="text-xs font-semibold text-[#E8973A] hover:text-[#D48429] flex items-center gap-1"
        >
          <span>{t('viewDetails')}</span>
          <span>→</span>
        </a>
      </div>

      <RecentSeekersTable
        client:load
        data={tableData}
        headers={headers}
      />
    </div>
  </div>
</DashboardLayout>
