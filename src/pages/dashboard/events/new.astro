---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import { EventForm } from '@/features/events/components/EventForm';

const { t, locale, supabase } = Astro.locals;

// Fetch active centers for the center selector
const { data: centers } = await supabase
  .from('centers')
  .select('*')
  .eq('is_active', true)
  .order('name_en');
---

<DashboardLayout title={t('events.addEvent')}>
  <div class="max-w-4xl mx-auto space-y-6">
    <div>
      <a href="/dashboard/events" class="text-xs font-semibold text-[#E8973A] hover:underline flex items-center gap-1 mb-1">
        <span>←</span>
        <span>{locale === 'gu' ? 'કાર્યક્રમ યાદી પર પાછા ફરો' : 'Back to Events'}</span>
      </a>
      <h1 class="text-xl sm:text-2xl font-bold text-gray-900 tracking-tight">
        {t('events.addEvent')}
      </h1>
      <p class="text-xs text-gray-500 mt-1">
        {locale === 'gu'
          ? 'નવી સમર્પણ ધ્યાન શિબિર અથવા વિશેષ સત્સંગ કાર્યક્રમનું આયોજન કરો.'
          : 'Schedule a new meditation camp, workshop, or special satsang program.'}
      </p>
    </div>

    <!-- Event Form Island -->
    <EventForm
      client:load
      centers={centers || []}
      locale={locale}
    />
  </div>
</DashboardLayout>
