---
import PublicLayout from '@/layouts/PublicLayout.astro';
import { Badge } from '@/components/react/ui/Badge';

const { t, locale, supabase } = Astro.locals;

let centers: any[] = [];
try {
  const { data } = await supabase
    .from('centers')
    .select('*')
    .eq('is_active', true)
    .order('name_en');
  centers = data || [];
} catch (err) {
  console.warn('Public centers fallback:', err);
}

if (centers.length === 0) {
  centers = [
    {
      id: '1',
      name_en: "Bhuj Main Samarpan Center",
      name_gu: "ભુજ મુખ્ય સમર્પણ ધ્યાન કેન્દ્ર",
      address_en: "Near Jubilee Ground, Bhuj - Kutch",
      address_gu: "જ્યુબિલી ગ્રાઉન્ડ પાસે, ભુજ - કચ્છ",
      contact_number: "02832-250000",
      shanchalak_name: "Rajeshbhai Patel",
      shanchalak_contact: "9825012345",
      meditation_days: ["Monday", "Wednesday", "Friday", "Sunday"],
      city: "Bhuj",
    },
    {
      id: '2',
      name_en: "Madhapar Meditation Center",
      name_gu: "માધાપર ધ્યાન કેન્દ્ર",
      address_en: "Community Hall, Main Bazar, Madhapar",
      address_gu: "કમ્યુનિટી હોલ, મુખ્ય બજાર, માધાપર",
      contact_number: "02832-260000",
      shanchalak_name: "Sureshbhai Vaghela",
      shanchalak_contact: "9879054321",
      meditation_days: ["Tuesday", "Thursday", "Sunday"],
      city: "Madhapar",
    },
    {
      id: '3',
      name_en: "Mirzapar Center",
      name_gu: "મિર્ઝાપર કેન્દ્ર",
      address_en: "Samarpan Hall, Highway Road, Mirzapar",
      address_gu: "સમર્પણ હોલ, હાઇવે રોડ, મિર્ઝાપર",
      contact_number: "02832-270000",
      shanchalak_name: "Pravinbhai Shah",
      shanchalak_contact: "9426098765",
      meditation_days: ["Daily"],
      city: "Mirzapar",
    },
  ];
}
---

<PublicLayout title={t('centers.title')}>
  <div class="py-12 sm:py-16 bg-[#FFF9F3]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
      <div class="text-center max-w-2xl mx-auto space-y-3">
        <span class="text-xs font-semibold text-[#E8973A] uppercase tracking-wider">
          {locale === 'gu' ? 'ધ્યાન સ્થાનો' : 'Spiritual Locations'}
        </span>
        <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">
          {t('centers.title')}
        </h1>
        <p class="text-xs sm:text-sm text-gray-600 leading-relaxed">
          {locale === 'gu'
            ? 'ભુજ અને સમગ્ર કચ્છમાં કાર્યરત સમર્પણ ધ્યાન કેન્દ્રો. તમામ સત્રો સહુ માટે નિઃશુલ્ક અને મુક્ત છે.'
            : 'Find your nearest Himalayan Samarpan Meditation center in Bhuj. Sessions are free and open to everyone.'}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {centers.map((c) => {
          const name = locale === 'gu' ? c.name_gu : c.name_en;
          const address = locale === 'gu' ? c.address_gu || c.address_en : c.address_en || c.address_gu;

          return (
            <div class="bg-white rounded-2xl border border-gray-100 p-6 shadow-2xs hover:shadow-md transition-shadow flex flex-col justify-between space-y-5">
              <div class="space-y-3">
                <div class="flex items-start justify-between">
                  <h3 class="font-bold text-gray-900 text-base leading-snug">
                    {name}
                  </h3>
                  <Badge variant="sage">{t('active')}</Badge>
                </div>

                <div class="space-y-2 text-xs text-gray-600">
                  <div class="flex items-start gap-2">
                    <span class="text-[#E8973A]">📍</span>
                    <span>{address || `${c.city}, Gujarat`}</span>
                  </div>

                  {c.shanchalak_name && (
                    <div class="flex items-center gap-2">
                      <span class="text-gray-400">👤</span>
                      <span>
                        {t('centers.shanchalak')}: <strong class="text-gray-800">{c.shanchalak_name}</strong>
                      </span>
                    </div>
                  )}

                  {c.shanchalak_contact && (
                    <div class="flex items-center gap-2">
                      <span class="text-gray-400">📞</span>
                      <a href={`tel:${c.shanchalak_contact}`} class="text-[#4A90D9] font-medium hover:underline">
                        {c.shanchalak_contact}
                      </a>
                    </div>
                  )}
                </div>

                {c.meditation_days && c.meditation_days.length > 0 && (
                  <div class="pt-3 border-t border-gray-50 flex flex-wrap gap-1.5">
                    {c.meditation_days.map((day: string) => (
                      <span class="px-2 py-0.5 bg-[#FFF9F3] text-[#C2741C] border border-[#FDEED9] rounded-md text-[10px] font-semibold">
                        {day}
                      </span>
                    ))}
                  </div>
                )}
              </div>

              <div class="pt-3 border-t border-gray-50 flex items-center justify-between text-xs">
                <span class="text-gray-400">Regular Session:</span>
                <span class="font-bold text-gray-900">06:30 AM - 07:15 AM</span>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </div>
</PublicLayout>
