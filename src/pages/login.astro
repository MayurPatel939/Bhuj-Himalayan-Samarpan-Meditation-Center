---
import AuthLayout from '../layouts/AuthLayout.astro';

const { t, locale, user } = Astro.locals;

// Redirect if already logged in
if (user) {
  return Astro.redirect('/dashboard');
}

const errorParam = Astro.url.searchParams.get('error');
const redirectParam = Astro.url.searchParams.get('redirect') || '/dashboard';
---

<AuthLayout title={t('auth.loginTitle')}>
  <div class="space-y-6">
    <div class="text-center">
      <h2 class="text-lg font-bold text-gray-900">
        {t('auth.loginTitle')}
      </h2>
      <p class="text-xs text-gray-500 mt-1">
        {t('auth.loginSubtitle')}
      </p>
    </div>

    {errorParam && (
      <div class="p-3 rounded-lg bg-red-50 border border-red-200 text-xs text-red-700 flex items-center gap-2">
        <span>⚠️</span>
        <span>{t('auth.invalidCredentials')}</span>
      </div>
    )}

    <!-- Auth Methods Tabs -->
    <div class="flex border-b border-gray-100 text-xs font-semibold">
      <button
        id="tab-btn-password"
        type="button"
        class="flex-1 pb-2.5 text-center border-b-2 border-[#E8973A] text-[#E8973A] cursor-pointer"
      >
        Password
      </button>
      <button
        id="tab-btn-magic"
        type="button"
        class="flex-1 pb-2.5 text-center border-b-2 border-transparent text-gray-400 hover:text-gray-700 cursor-pointer"
      >
        Magic Link
      </button>
      <button
        id="tab-btn-otp"
        type="button"
        class="flex-1 pb-2.5 text-center border-b-2 border-transparent text-gray-400 hover:text-gray-700 cursor-pointer"
      >
        Mobile OTP
      </button>
    </div>

    <!-- Tab 1: Password Form -->
    <form id="form-password" action="/api/auth/login" method="POST" class="space-y-4">
      <input type="hidden" name="auth_type" value="password" />
      <input type="hidden" name="redirect" value={redirectParam} />

      <div>
        <label class="block text-xs font-medium text-gray-700 mb-1">{t('auth.email')}</label>
        <input
          type="email"
          name="email"
          required
          placeholder="coordinator@bhujdhyan.org"
          class="w-full px-3 py-2 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-[#E8973A] focus:border-transparent"
        />
      </div>

      <div>
        <label class="block text-xs font-medium text-gray-700 mb-1">{t('auth.password')}</label>
        <input
          type="password"
          name="password"
          required
          placeholder="••••••••"
          class="w-full px-3 py-2 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-[#E8973A] focus:border-transparent"
        />
      </div>

      <button
        type="submit"
        class="w-full py-2.5 px-4 rounded-lg bg-[#E8973A] hover:bg-[#D48429] text-white text-xs font-bold shadow-xs transition-colors cursor-pointer"
      >
        {t('nav.login')}
      </button>
    </form>

    <!-- Tab 2: Magic Link Form -->
    <form id="form-magic" class="space-y-4 hidden">
      <input type="hidden" name="auth_type" value="magic_link" />

      <div>
        <label class="block text-xs font-medium text-gray-700 mb-1">{t('auth.email')}</label>
        <input
          type="email"
          id="magic-email"
          name="email"
          required
          placeholder="coordinator@bhujdhyan.org"
          class="w-full px-3 py-2 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-[#E8973A] focus:border-transparent"
        />
      </div>

      <div id="magic-status" class="hidden text-xs font-medium"></div>

      <button
        type="button"
        id="magic-submit-btn"
        class="w-full py-2.5 px-4 rounded-lg bg-[#4A90D9] hover:bg-[#397AC0] text-white text-xs font-bold shadow-xs transition-colors cursor-pointer"
      >
        {t('auth.sendMagicLink')}
      </button>
    </form>

    <!-- Tab 3: Mobile OTP Form -->
    <div id="form-otp" class="space-y-4 hidden">
      <div id="otp-step-phone">
        <label class="block text-xs font-medium text-gray-700 mb-1">{t('auth.phone')}</label>
        <div class="flex gap-2">
          <input
            type="tel"
            id="otp-phone"
            placeholder="9876543210"
            class="flex-1 px-3 py-2 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-[#E8973A] focus:border-transparent"
          />
          <button
            type="button"
            id="otp-send-btn"
            class="px-3 py-2 rounded-lg bg-gray-100 hover:bg-gray-200 text-gray-700 text-xs font-semibold cursor-pointer"
          >
            {t('auth.sendOtp')}
          </button>
        </div>
      </div>

      <div id="otp-step-verify" class="space-y-3 hidden">
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-1">{t('auth.otp')}</label>
          <input
            type="text"
            id="otp-token"
            placeholder="6-digit code"
            maxlength="6"
            class="w-full px-3 py-2 border border-gray-200 rounded-lg text-sm text-center tracking-widest font-mono text-base focus:outline-none focus:ring-2 focus:ring-[#E8973A]"
          />
        </div>
        <button
          type="button"
          id="otp-verify-btn"
          class="w-full py-2.5 px-4 rounded-lg bg-[#6B9F78] hover:bg-[#598A65] text-white text-xs font-bold shadow-xs transition-colors cursor-pointer"
        >
          {t('auth.verifyOtp')}
        </button>
      </div>

      <div id="otp-status" class="hidden text-xs font-medium"></div>
    </div>

    <!-- Divider -->
    <div class="relative flex items-center justify-center">
      <div class="border-t border-gray-200 w-full"></div>
      <span class="bg-white px-2 text-[11px] text-gray-400 uppercase tracking-wider relative">
        {t('auth.orSignInWith')}
      </span>
    </div>

    <!-- Google OAuth Button -->
    <form action="/api/auth/login" method="POST">
      <input type="hidden" name="auth_type" value="google" />
      <button
        type="submit"
        class="w-full flex items-center justify-center gap-2.5 py-2.5 px-4 border border-gray-200 rounded-lg text-xs font-semibold text-gray-700 bg-white hover:bg-gray-50 transition-colors shadow-2xs cursor-pointer"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" />
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" />
        </svg>
        <span>{t('auth.googleSignIn')}</span>
      </button>
    </form>
  </div>
</AuthLayout>

<script>
  // Tab Switching
  const btnPassword = document.getElementById('tab-btn-password');
  const btnMagic = document.getElementById('tab-btn-magic');
  const btnOtp = document.getElementById('tab-btn-otp');

  const formPassword = document.getElementById('form-password');
  const formMagic = document.getElementById('form-magic');
  const formOtp = document.getElementById('form-otp');

  function setTab(activeBtn: HTMLElement, activeForm: HTMLElement) {
    [btnPassword, btnMagic, btnOtp].forEach((b) => {
      b?.classList.remove('border-[#E8973A]', 'text-[#E8973A]');
      b?.classList.add('border-transparent', 'text-gray-400');
    });
    activeBtn.classList.remove('border-transparent', 'text-gray-400');
    activeBtn.classList.add('border-[#E8973A]', 'text-[#E8973A]');

    [formPassword, formMagic, formOtp].forEach((f) => f?.classList.add('hidden'));
    activeForm.classList.remove('hidden');
  }

  btnPassword?.addEventListener('click', () => setTab(btnPassword, formPassword!));
  btnMagic?.addEventListener('click', () => setTab(btnMagic, formMagic!));
  btnOtp?.addEventListener('click', () => setTab(btnOtp, formOtp!));

  // Magic Link handler
  const magicBtn = document.getElementById('magic-submit-btn');
  const magicEmail = document.getElementById('magic-email') as HTMLInputElement;
  const magicStatus = document.getElementById('magic-status');

  magicBtn?.addEventListener('click', async () => {
    if (!magicEmail?.value) return;
    magicBtn.textContent = 'Sending...';
    const fd = new FormData();
    fd.append('auth_type', 'magic_link');
    fd.append('email', magicEmail.value);

    try {
      const res = await fetch('/api/auth/login', { method: 'POST', body: fd });
      const data = await res.json();
      if (res.ok) {
        magicStatus!.className = 'p-2 rounded bg-green-50 text-green-700 text-xs';
        magicStatus!.textContent = 'Check your email for the magic sign-in link!';
        magicStatus!.classList.remove('hidden');
      } else {
        magicStatus!.className = 'p-2 rounded bg-red-50 text-red-700 text-xs';
        magicStatus!.textContent = data.error || 'Failed to send magic link';
        magicStatus!.classList.remove('hidden');
      }
    } catch {
      magicStatus!.className = 'p-2 rounded bg-red-50 text-red-700 text-xs';
      magicStatus!.textContent = 'Connection error';
      magicStatus!.classList.remove('hidden');
    } finally {
      magicBtn.textContent = 'Send Magic Link';
    }
  });

  // Mobile OTP handler
  const otpPhone = document.getElementById('otp-phone') as HTMLInputElement;
  const otpSendBtn = document.getElementById('otp-send-btn');
  const otpStepVerify = document.getElementById('otp-step-verify');
  const otpToken = document.getElementById('otp-token') as HTMLInputElement;
  const otpVerifyBtn = document.getElementById('otp-verify-btn');
  const otpStatus = document.getElementById('otp-status');

  otpSendBtn?.addEventListener('click', async () => {
    if (!otpPhone?.value) return;
    otpSendBtn.textContent = 'Sending...';
    const fd = new FormData();
    fd.append('auth_type', 'otp_request');
    fd.append('phone', otpPhone.value);

    try {
      const res = await fetch('/api/auth/login', { method: 'POST', body: fd });
      const data = await res.json();
      if (res.ok) {
        otpStepVerify?.classList.remove('hidden');
        otpStatus!.className = 'p-2 rounded bg-blue-50 text-blue-700 text-xs';
        otpStatus!.textContent = 'OTP sent! Please enter the 6-digit code below.';
        otpStatus!.classList.remove('hidden');
      } else {
        otpStatus!.className = 'p-2 rounded bg-red-50 text-red-700 text-xs';
        otpStatus!.textContent = data.error || 'Failed to send OTP';
        otpStatus!.classList.remove('hidden');
      }
    } catch {
      otpStatus!.className = 'p-2 rounded bg-red-50 text-red-700 text-xs';
      otpStatus!.textContent = 'Connection error';
      otpStatus!.classList.remove('hidden');
    } finally {
      otpSendBtn.textContent = 'Send OTP';
    }
  });

  otpVerifyBtn?.addEventListener('click', async () => {
    if (!otpToken?.value) return;
    otpVerifyBtn.textContent = 'Verifying...';
    const fd = new FormData();
    fd.append('auth_type', 'otp_verify');
    fd.append('phone', otpPhone.value);
    fd.append('token', otpToken.value);

    try {
      const res = await fetch('/api/auth/login', { method: 'POST', body: fd });
      if (res.redirected) {
        window.location.href = res.url;
      } else {
        const data = await res.json();
        otpStatus!.className = 'p-2 rounded bg-red-50 text-red-700 text-xs';
        otpStatus!.textContent = data.error || 'Invalid OTP code';
        otpStatus!.classList.remove('hidden');
      }
    } catch {
      otpStatus!.className = 'p-2 rounded bg-red-50 text-red-700 text-xs';
      otpStatus!.textContent = 'Verification error';
      otpStatus!.classList.remove('hidden');
    } finally {
      otpVerifyBtn.textContent = 'Verify & Sign In';
    }
  });
</script>
