---
import PublicLayout from '../layouts/PublicLayout.astro';
import { Card } from '../components/react/ui/Card';
import { Badge } from '../components/react/ui/Badge';

const { t, locale } = Astro.locals;

// Sample public centers for display
const sampleCenters = [
  {
    name_en: "Bhuj Main Samarpan Center",
    name_gu: "ભુજ મુખ્ય સમર્પણ ધ્યાન કેન્દ્ર",
    address_en: "Near Jubilee Ground, Bhuj - Kutch",
    address_gu: "જ્યુબિલી ગ્રાઉન્ડ પાસે, ભુજ - કચ્છ",
    shanchalak: "Rajeshbhai Patel",
    timings: "06:30 AM - 07:15 AM",
    days: "Daily / દરરોજ",
  },
  {
    name_en: "Madhapar Meditation Center",
    name_gu: "માધાપર ધ્યાન કેન્દ્ર",
    address_en: "Community Hall, Madhapar, Bhuj",
    address_gu: "કમ્યુનિટી હોલ, માધાપર, ભુજ",
    shanchalak: "Sureshbhai Vaghela",
    timings: "07:00 AM - 07:45 AM",
    days: "Tue, Thu, Sun / મંગળ, ગુરુ, રવિ",
  },
  {
    name_en: "Mirzapar Center",
    name_gu: "મિર્ઝાપર કેન્દ્ર",
    address_en: "Samarpan Hall, Mirzapar Highway",
    address_gu: "સમર્પણ હોલ, મિર્ઝાપર હાઇવે",
    shanchalak: "Pravinbhai Shah",
    timings: "06:00 AM - 06:45 AM",
    days: "Daily / દરરોજ",
  },
];
---

<PublicLayout title="Home">
  <!-- Hero Section -->
  <section class="relative overflow-hidden py-16 sm:py-24 meditation-gradient">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center max-w-3xl mx-auto space-y-6">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-[#FDEED9] border border-[#E8973A]/30 text-xs font-semibold text-[#C2741C]">
          <span>✨</span>
          <span>{locale === 'gu' ? 'મફત અને સહજ ધ્યાન સાધના' : 'Free & Natural Meditation Practice'}</span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-extrabold text-gray-900 tracking-tight leading-tight">
          {locale === 'gu' 
            ? 'આંતરિક શાંતિ અને આધ્યાત્મિક જાગૃતિ તરફ એક પગલું' 
            : 'Experience Deep Inner Peace with Himalayan Samarpan Meditation'}
        </h1>

        <p class="text-base sm:text-lg text-gray-600 leading-relaxed">
          {locale === 'gu'
            ? 'હિમાલયન સમર્પણ ધ્યાન એ સરળ, પ્રાકૃતિક અને કોઈપણ ધર્મ, જ્ઞાતિ કે વયના લોકો માટે સંપૂર્ણપણે નિઃશુલ્ક પદ્ધતિ છે. ભુજ અને કચ્છના વિવિધ કેન્દ્રો પર દરરોજ સામૂહિક ધ્યાન યોજાય છે.'
            : 'A simple, natural 30-minute daily practice that connects you with universal consciousness. Purely experiential, open to all seekers free of charge across multiple centers in Bhuj, Gujarat.'}
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4">
          <a
            href="#centers"
            class="w-full sm:w-auto px-6 py-3 rounded-xl bg-[#E8973A] hover:bg-[#D48429] text-white font-semibold text-sm shadow-md shadow-[#E8973A]/20 transition-all text-center cursor-pointer"
          >
            {locale === 'gu' ? 'કેન્દ્રો અને સમય જુઓ' : 'Find a Meditation Center'}
          </a>
          <a
            href="/login"
            class="w-full sm:w-auto px-6 py-3 rounded-xl bg-white hover:bg-gray-50 text-gray-800 font-semibold text-sm border border-gray-200 shadow-2xs transition-all text-center cursor-pointer"
          >
            {locale === 'gu' ? 'સેવક / સંયોજક લોગિન' : 'Coordinator Portal'}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Key Pillars / About Practice -->
  <section class="py-16 bg-white border-y border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="p-6 rounded-2xl bg-[#FFF9F3] border border-[#FDEED9] space-y-3">
          <div class="w-10 h-10 rounded-xl bg-[#E8973A]/15 text-[#C2741C] flex items-center justify-center font-bold text-lg">
            🧘
          </div>
          <h3 class="text-base font-bold text-gray-900">
            {locale === 'gu' ? 'માત્ર ૩૦ મિનિટનું ધ્યાન' : 'Simple 30-Minute Daily Practice'}
          </h3>
          <p class="text-xs text-gray-600 leading-relaxed">
            {locale === 'gu'
              ? 'કોઈ કઠિન આસન કે શારીરિક કસરત વગર, માત્ર શાંત ચિત્તે બેસીને આત્માની અનુભૂતિ કરવાની સરળ પદ્ધતિ.'
              : 'No difficult postures or strain. Simply sit comfortably, close your eyes, and surrender your thoughts for profound mental stillness.'}
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-[#E8F2FC] border border-[#4A90D9]/20 space-y-3">
          <div class="w-10 h-10 rounded-xl bg-[#4A90D9]/15 text-[#2F6DB1] flex items-center justify-center font-bold text-lg">
            🕊️
          </div>
          <h3 class="text-base font-bold text-gray-900">
            {locale === 'gu' ? 'સંપૂર્ણ નિઃશુલ્ક સેવા' : 'Completely Free of Cost'}
          </h3>
          <p class="text-xs text-gray-600 leading-relaxed">
            {locale === 'gu'
              ? 'સમર્પણ ધ્યાન ક્યારેય કોઈ ફી કે દાન પર નિર્ભર નથી. આધ્યાત્મિક જ્ઞાન સહુ માટે મુક્ત અને સુલભ છે.'
              : 'Spirituality is a divine birthright. All sessions, meditation camps, and centers are organized by volunteers with zero commercial interest.'}
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-[#EDF5EF] border border-[#6B9F78]/20 space-y-3">
          <div class="w-10 h-10 rounded-xl bg-[#6B9F78]/15 text-[#4F7959] flex items-center justify-center font-bold text-lg">
            🌸
          </div>
          <h3 class="text-base font-bold text-gray-900">
            {locale === 'gu' ? 'સર્વધર્મ સમભાવ' : 'Beyond Religion and Caste'}
          </h3>
          <p class="text-xs text-gray-600 leading-relaxed">
            {locale === 'gu'
              ? 'કોઈપણ સંપ્રદાય, માન્યતા કે પૃષ્ઠભૂમિ ધરાવતી વ્યક્તિ આ ધ્યાનમાં સહભાગી થઈ શકે છે.'
              : 'Universal and inclusive. Samarpan unites human consciousness without requiring any conversion or dogmatic beliefs.'}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Centers Listing Section -->
  <section id="centers" class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 gap-4">
      <div>
        <span class="text-xs font-semibold text-[#E8973A] uppercase tracking-wider">
          {locale === 'gu' ? 'સ્થાનિક શાખાઓ' : 'Bhuj Locations'}
        </span>
        <h2 class="text-2xl font-bold text-gray-900 mt-1">
          {t('centers.title')}
        </h2>
      </div>
      <p class="text-xs text-gray-500 max-w-md">
        {locale === 'gu'
          ? 'આપની નજીકના સમર્પણ ધ્યાન કેન્દ્રની મુલાકાત લો અને સામૂહિક ધ્યાનની શક્તિ અનુભવો.'
          : 'Visit any of our active centers across Bhuj. Regular morning sessions are open to beginners.'}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {sampleCenters.map((center) => (
        <div class="bg-white rounded-2xl border border-gray-100 p-6 shadow-sm hover:shadow-md transition-shadow space-y-4">
          <div class="flex items-start justify-between">
            <h3 class="font-bold text-gray-900 text-base leading-snug">
              {locale === 'gu' ? center.name_gu : center.name_en}
            </h3>
            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-[#EDF5EF] text-[#4F7959]">
              {t('active')}
            </span>
          </div>

          <div class="space-y-2 text-xs text-gray-600">
            <div class="flex items-start gap-2">
              <span class="text-gray-400">📍</span>
              <span>{locale === 'gu' ? center.address_gu : center.address_en}</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-gray-400">⏰</span>
              <span class="font-medium text-gray-900">{center.timings}</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-gray-400">📅</span>
              <span>{center.days}</span>
            </div>
            <div class="flex items-center gap-2 pt-2 border-t border-gray-50 text-[11px] text-gray-500">
              <span>{t('centers.shanchalak')}:</span>
              <span class="font-medium text-gray-700">{center.shanchalak}</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>
</PublicLayout>
