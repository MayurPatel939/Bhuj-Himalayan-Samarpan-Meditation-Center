---
import BaseLayout from './BaseLayout.astro';
import LanguageSwitcher from '../components/astro/LanguageSwitcher.astro';

interface Props {
  title?: string;
}

const { title } = Astro.props;
const { t } = Astro.locals;
---

<BaseLayout title={title}>
  <div class="min-h-screen flex flex-col justify-center py-12 sm:px-6 lg:px-8 meditation-gradient relative">
    <!-- Top Right Language Switcher -->
    <div class="absolute top-4 right-4">
      <LanguageSwitcher />
    </div>

    <!-- Centered Brand -->
    <div class="sm:mx-auto sm:w-full sm:max-w-md text-center px-4">
      <a href="/" class="inline-flex items-center gap-3 mb-3">
        <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-[#E8973A] to-[#F3AA55] flex items-center justify-center text-white shadow-md shadow-[#E8973A]/25">
          <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
        </div>
      </a>
      <h1 class="text-xl sm:text-2xl font-bold text-gray-900 tracking-tight">
        {t('appName')}
      </h1>
      <p class="text-xs text-gray-500 mt-1">
        {t('tagline')}
      </p>
    </div>

    <!-- Auth Card Slot -->
    <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-md px-4">
      <div class="bg-white/95 backdrop-blur-md py-8 px-6 shadow-xl shadow-gray-200/50 sm:rounded-2xl border border-gray-100 sm:px-10">
        <slot />
      </div>
    </div>
  </div>
</BaseLayout>
